@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ==============================================================
echo   อัปเดตสถานการณ์โรคใบด่างมันสำปะหลัง (ทุก 2 สัปดาห์ / รายเดือน)
echo   1) วางไฟล์ "รายงานใบด่าง ....xlsx" ฉบับใหม่ไว้ในโฟลเดอร์ "รายงานใบด่าง"
echo   2) ถ้ามีทะเบียนเกษตรกรฉบับใหม่ วางทับในโฟลเดอร์ทะเบียนเดิม
echo ==============================================================
python tools\build_reports.py
if errorlevel 1 (
  echo.
  echo [ผิดพลาด] สร้างข้อมูลไม่สำเร็จ กรุณาตรวจสอบไฟล์รายงาน
  pause
  exit /b 1
)
echo.
set /p OK=เผยแพร่ขึ้นเว็บไซต์ตอนนี้หรือไม่? (Y/N):
if /i not "%OK%"=="Y" (
  echo ยังไม่เผยแพร่ - เปิด index.html เพื่อตรวจดูในเครื่องได้
  pause
  exit /b 0
)
git add data/reports.js
git commit -m "อัปเดตรายงานโรคใบด่าง %date%"
git push
echo.
echo เผยแพร่แล้ว เว็บไซต์จะอัปเดตภายใน 1-2 นาที
pause
